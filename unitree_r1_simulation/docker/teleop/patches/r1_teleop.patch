+WEBXR_FINGERS = {"index": (6, 7, 9), "middle": (11, 12, 14), "ring": (16, 17, 19), "pinky": (21, 22, 24)}
+BRAINCO_MOTORS = ("thumb_metacarpal", "thumb_proximal", "index_proximal", "middle_proximal", "ring_proximal", "pinky_proximal")
+BRAINCO_RANGES = (1.5184, 1.0472, 1.4661, 1.4661, 1.4661, 1.4661)
+BRAINCO_COUPLING = {"thumb_proximal": ("thumb_distal", 1.0), "index_proximal": ("index_distal", 1.155),
+                    "middle_proximal": ("middle_distal", 1.155), "ring_proximal": ("ring_distal", 1.155),
+                    "pinky_proximal": ("pinky_distal", 1.155)}
+
+def _angle(a, b):
+    na, nb = np.linalg.norm(a), np.linalg.norm(b)
+    if na < 1e-9 or nb < 1e-9:
+        return 0.0
+    return float(np.degrees(np.arccos(np.clip(a @ b / (na * nb), -1.0, 1.0))))
+
+def _palm_axes(wrist, middle, index, pinky, side):
+    f = middle - wrist
+    f = f / max(np.linalg.norm(f), 1e-9)
+    l = index - pinky
+    l = l - f * (f @ l)
+    l = l / max(np.linalg.norm(l), 1e-9)
+    n = np.cross(f, l)
+    return f, l, (n if side == "left" else -n)
+
+def hand_measures(p, side):
+    f, l, palmar = _palm_axes(p[0], p[11], p[6], p[21], side)
+    out = {}
+    for name, (mcp, pip, tip) in WEBXR_FINGERS.items():
+        out[name] = _angle(p[mcp] - p[0], p[pip] - p[mcp]) + _angle(p[pip] - p[mcp], p[tip] - p[pip])
+    meta, prox, dist = p[2] - p[1], p[3] - p[2], p[4] - p[3]
+    out["thumb_flex"] = _angle(meta, prox) + _angle(prox, dist)
+    out["thumb_swing"] = float(np.degrees(np.arctan2(meta @ palmar, meta @ l)))
+    return out
+
+class BraincoDirectMapping:
+    def __init__(self, urdf="/opt/r1_model/r1_brainco.urdf", samples=60):
+        import pinocchio as pin
+        model = pin.buildModelFromUrdf(urdf)
+        data = model.createData()
+        self.tables = {}
+        for side in ("left", "right"):
+            def idx(joint):
+                return model.joints[model.getJointId(f"{side}_{joint}_joint")].idx_q
+            def pos(link):
+                return data.oMf[model.getFrameId(f"{side}_{link}")].translation.copy()
+            def robot_hand():
+                p = np.zeros((25, 3))
+                p[0], p[1], p[2] = pos("hand_palm_link"), pos("thumb_metacarpal_link"), pos("thumb_proximal_link")
+                p[3], p[4] = pos("thumb_distal_link"), pos("thumb_tip_link")
+                for name, (mcp, pip, tip) in WEBXR_FINGERS.items():
+                    p[mcp], p[pip], p[tip] = pos(f"{name}_proximal_link"), pos(f"{name}_distal_link"), pos(f"{name}_tip_link")
+                return p
+            tables = []
+            for motor, top in zip(BRAINCO_MOTORS, BRAINCO_RANGES):
+                key = {"thumb_metacarpal": "thumb_swing", "thumb_proximal": "thumb_flex"}.get(motor, motor.split("_")[0])
+                qs, ms = np.linspace(0.0, top, samples), []
+                for q in qs:
+                    qq = pin.neutral(model)
+                    qq[idx(motor)] = q
+                    if motor in BRAINCO_COUPLING:
+                        coupled, ratio = BRAINCO_COUPLING[motor]
+                        qq[idx(coupled)] = ratio * q
+                    pin.framesForwardKinematics(model, data, qq)
+                    ms.append(hand_measures(robot_hand(), side)[key])
+                ms = np.maximum.accumulate(np.asarray(ms))
+                if ms[-1] - ms[0] < 10.0:
+                    raise ValueError(f"BraincoDirectMapping: {side} {motor} barely moves its {key} angle")
+                tables.append((key, ms, qs / top))
+            self.tables[side] = tables
+
+    def ranges(self, side):
+        return {key: (round(float(ms[0]), 1), round(float(ms[-1]), 1)) for key, ms, _ in self.tables[side]}
+
+    def __call__(self, positions, side):
+        m = hand_measures(np.asarray(positions, dtype=float).reshape(25, 3), side)
+        return np.array([np.interp(m[key], ms, norm) for key, ms, norm in self.tables[side]])
+
