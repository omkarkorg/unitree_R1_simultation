+        if stance is not None:
+            c, s = np.cos(yaw_r), np.sin(yaw_r)
+            o = self.stance_offset
+            err = self.anchor - (stance + np.array([c * o[0] - s * o[1], s * o[0] + c * o[1]]))
+        else:
+            err = self.anchor - root[:2, 3]
+        cr, sr = np.cos(yaw_r), np.sin(yaw_r)
+        e_body = np.array([cr * err[0] + sr * err[1], -sr * err[0] + cr * err[1]])
+        e_yaw = wrap(self.yaw_target - yaw_r)
+        self.walking = moving and not self.pose_mode and np.linalg.norm(e_body) > (self.DEADBAND if self.walking else self.WALK_START)
+        self.turning = moving and not self.pose_mode and abs(e_yaw) > (self.YAW_DEADBAND if self.turning else self.TURN_START)
