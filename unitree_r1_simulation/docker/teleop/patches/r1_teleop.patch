+class HandWatch:
+    def __init__(self, tvuer, timeout=0.3):
+        self.tvuer, self.timeout, self.last = tvuer, timeout, float("-inf")
+        self.prev = self._raw()
+        self.updates = []
+
+    def _raw(self):
+        return np.concatenate([self.tvuer.left_arm_pose.ravel(), self.tvuer.right_arm_pose.ravel()])
+
+    def tracked(self, now):
+        raw = self._raw()
+        if not np.array_equal(raw, self.prev):
+            self.prev = raw
+            if all(abs(np.linalg.det(m.reshape(4, 4))) > 1e-6 for m in (raw[:16], raw[16:])):
+                self.last = now
+                self.updates = [t for t in self.updates if t > now - 2.0] + [now]
+        return now - self.last < self.timeout
+
+    def rate(self, now):
+        return len([t for t in self.updates if t > now - 2.0]) / 2.0
