+def to_room(T, P):
+    Q = T @ P
+    Q[:3, :3] /= np.linalg.norm(T[:3, 0])
+    return Q
+
+def from_room(T, P):
+    Q = np.linalg.inv(T) @ P
+    Q[:3, :3] *= np.linalg.norm(T[:3, 0])
+    return Q
+
+def palm_frame(wrist, middle, index, pinky):
+    x = middle - wrist
+    x = x / max(np.linalg.norm(x), 1e-9)
+    y = index - pinky
+    y = y - x * (x @ y)
+    y = y / max(np.linalg.norm(y), 1e-9)
+    T = np.eye(4)
+    T[:3, :3] = np.column_stack([x, y, np.cross(x, y)])
+    T[:3, 3] = 0.5 * (wrist + middle)
+    return T
+
+def operator_palm(points):
+    return palm_frame(points[0], points[11], points[6], points[21])
