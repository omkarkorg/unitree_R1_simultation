+def overlay_text(bgr, lines, binocular):
+    import cv2
+    img = bgr.copy()
+    h, w = img.shape[:2]
+    eye_w = w // 2 if binocular else w
+    shift = int(0.023 * h) if binocular else 0
+    for x0, dx in (((0, shift), (eye_w, -shift)) if binocular else ((0, 0),)):
+        y = int(0.30 * h)
+        for text, size in lines:
+            scale = size * h / 480.0
+            thick = max(2, int(round(2.5 * scale)))
+            (tw, th), _ = cv2.getTextSize(text, cv2.FONT_HERSHEY_SIMPLEX, scale, thick)
+            org = (x0 + (eye_w - tw) // 2 + dx, y + th)
+            cv2.putText(img, text, org, cv2.FONT_HERSHEY_SIMPLEX, scale, (0, 0, 0), thick + 6, cv2.LINE_AA)
+            cv2.putText(img, text, org, cv2.FONT_HERSHEY_SIMPLEX, scale, (255, 255, 255), thick, cv2.LINE_AA)
+            y += th + int(0.06 * h)
+    return img
