+def relative_target(robot0, human0, human, robot_now, human_prev):
+    target = np.eye(4)
+    target[:3, 3] = robot0[:3, 3] + (human[:3, 3] - human0[:3, 3])
+    target[:3, :3] = robot_now[:3, :3] @ human_prev[:3, :3].T @ human[:3, :3]
+    return target
