+    def __init__(self, url):
+        import json, zmq
+        self.root, self.q, self.stamp = None, None, 0.0
+        self.stance = None
+        self.sim_time, self.jumps = 0.0, 0
+        self._json = json
+        self._ctx = zmq.Context()
+        self._sock = self._ctx.socket(zmq.SUB)
+        self._sock.setsockopt(zmq.CONFLATE, 1)
+        self._sock.setsockopt(zmq.SUBSCRIBE, b"")
+        self._sock.connect(url)
+        self._stop = False
+        threading.Thread(target=self._run, daemon=True).start()
+
+    def _run(self):
+        while not self._stop:
+            if self._sock.poll(100):
+                msg = self._json.loads(self._sock.recv())
+                t = float(msg.get("t", 0.0))
+                if msg.get("root") is not None:
+                    root = pose_from_xyzw(msg["root"])
+                    if self.root is not None:
+                        d = float(np.linalg.norm(root[:3, 3] - self.root[:3, 3]))
+                        if d > self.JUMP and (t <= self.sim_time or d / (t - self.sim_time) > self.JUMP_SPEED):
+                            self.jumps += 1
+                    self.root = root
+                if msg.get("stance") is not None:
+                    self.stance = np.asarray(msg["stance"], dtype=float)
+                self.sim_time = t
+                self.q = np.asarray(msg["q"], dtype=float)
+                self.stamp = time.time()
+
+    def fresh(self, now, max_age=0.5):
+        return self.root is not None and now - self.stamp < max_age
+
+    def close(self):
+        self._stop = True
+
+def yaw_of(R):
+    return float(np.arctan2(R[1, 0], R[0, 0]))
+
+def wrap(a):
+    return float((a + np.pi) % (2.0 * np.pi) - np.pi)
+
+class BodyFollower:
+    LEASH, LEASH_PER_DROP, DEADBAND, WALK_START, K_POS = 0.08, 0.5, 0.04, 0.15, 1.8
+    YAW_LEASH, YAW_DEADBAND, TURN_START, K_YAW = np.radians(30.0), 0.10, 0.25, 1.8
+    V_MIN, WZ_MIN = 0.3, 0.6
+    VX, VY, WZ = (-0.3, 0.6), (-0.25, 0.25), 0.8
+    V_MAX, WZ_MAX, H_RATE, PITCH_RATE = 1.0, 2.0, 0.6, 1.5
+    H_NOM, H_MIN, PITCH_MAX = 0.725, 0.65, 0.55
+    NECK_TO_EYE = np.array([0.0805, 0.0, 0.075])
+    W_NECK, W_REACH, W_UPRIGHT, SMOOTH = 1.0, 4.0, 0.02, 0.15
+    HOLD_MARGIN = 2.25e-4
+    REACH_LEAN = 0.15
+
+    def __init__(self, geometry, send=None, body=None):
+        self.geo = geometry
+        body = body or {}
+        self.pose_mode = body.get("mode") == "exact"
+        self.H_MIN = float(body.get("h_min", self.H_MIN))
+        self.H_NOM = float(body.get("h_nom", self.H_NOM))
+        self.PITCH_MAX = float(body.get("pitch_max", self.PITCH_MAX))
+        if self.pose_mode:
+            self.REACH_LEAN = self.PITCH_MAX
+        if send is None:
+            import json
+            pub = ChannelPublisher("rt/sim/body_cmd", String_)
+            pub.Init()
+            send = lambda d: pub.Write(String_(data=json.dumps(d)))
+        self._send = send
+        hs = np.linspace(self.H_MIN, self.H_NOM, int(round((self.H_NOM - self.H_MIN) / 0.005)) + 1)
+        ps = np.linspace(0.0, self.PITCH_MAX, int(round(self.PITCH_MAX / 0.01)) + 1)
+        self.grid = np.array([(h, p) for h in hs for p in ps])
+        self.scale = 1.0
+        self.command = [0.0, 0.0, 0.0, self.H_NOM, 0.0]
+        self.sent = False
+        self.active = self.walking = self.turning = False
+
+    def neck_of(self, head):
+        return head[:3, 3] - head[:3, :3] @ self.NECK_TO_EYE / self.scale
+
+    def cost(self, h, p, neck, palms):
+        c, s = np.cos(p), np.sin(p)
+        n = self.neck
+        cost = self.W_NECK * ((c * n[0] + s * n[2] - neck[0]) ** 2 + (h - s * n[0] + c * n[2] - neck[1]) ** 2) \
+            + self.W_UPRIGHT * p ** 2
+        pr = np.minimum(p, self.REACH_LEAN)
+        cr, sr = np.cos(pr), np.sin(pr)
+        for side, palm in zip(("left", "right"), palms):
+            if palm is None:
+                continue
+            f, l, z = palm
+            q = self.geo.shoulder[side]
+            dist = np.sqrt((cr * q[0] + sr * q[2] - f) ** 2 + (q[1] - l) ** 2 + (h - sr * q[0] + cr * q[2] - z) ** 2)
+            cost = cost + self.W_REACH * np.maximum(dist - self.geo.reach, 0.0) ** 2
+        return cost
+
+    def start(self, root, eye_z, stance=None, head=None, scale=1.0):
+        self.scale = float(scale)
+        self.neck = self.geo.eye - self.NECK_TO_EYE / self.scale
+        self.anchor = root[:3, 3][:2].copy()
+        yaw = yaw_of(root[:3, :3])
+        c, s = np.cos(yaw), np.sin(yaw)
+        d = self.anchor - (stance if stance is not None else self.anchor)
+        self.stance_offset = np.array([c * d[0] + s * d[1], -s * d[0] + c * d[1]])
+        self.yaw_target = yaw
+        self.eye_z0 = float(eye_z)
+        self.h, self.p, self.t = self.H_NOM, 0.0, None
+        self.goal = np.array([self.H_NOM, 0.0])
+        self.pose = np.array([self.anchor[0], self.anchor[1], yaw, self.H_NOM, 0.0])
+        self.neck_offset = np.zeros(3)
+        if head is not None:
+            n = np.array([self.anchor[0] + c * self.neck[0] - s * self.neck[1],
+                          self.anchor[1] + s * self.neck[0] + c * self.neck[1], self.H_NOM + self.neck[2]]) - self.neck_of(head)
+            self.neck_offset = np.array([c * n[0] + s * n[1], -s * n[0] + c * n[1], n[2]])
+        self.walking = self.turning = False
+        self.active = True
+
+    def step(self, now, head, palms, root, moving, stance=None):
+        dt = 0.0 if self.t is None else min(max(now - self.t, 0.0), 0.2)
+        self.t = now
+        yaw_r = yaw_of(root[:3, :3])
+        neck_xy = self.neck[:2]
+        if moving:
+            gaze = head[:3, 0]
+            if np.hypot(gaze[0], gaze[1]) > 0.2:
+                d = wrap(np.arctan2(gaze[1], gaze[0]) - self.yaw_target)
+                if abs(d) > self.YAW_LEASH:
+                    self.yaw_target = wrap(self.yaw_target + d - np.sign(d) * self.YAW_LEASH)
+            c, s = np.cos(self.yaw_target), np.sin(self.yaw_target)
+            o = self.neck_offset
+            neck = self.neck_of(head) + np.array([c * o[0] - s * o[1], s * o[0] + c * o[1], o[2]])
+            want = neck[:2] - np.array([c * neck_xy[0] - s * neck_xy[1], s * neck_xy[0] + c * neck_xy[1]])
+            drop = max(0.0, self.eye_z0 - head[2, 3])
+            leash = self.LEASH / self.scale + self.LEASH_PER_DROP * drop
+            gap = want - self.anchor
+            if self.walking and not self.pose_mode:
+                self.anchor = want.copy()
+            elif np.linalg.norm(gap) > leash:
+                self.anchor = self.anchor + gap * (1.0 - leash / np.linalg.norm(gap))
+        if self.pose_mode:
