+class RobotGeometry:
+    def __init__(self, urdf, camera_mount):
+        import pinocchio as pin
+        model = pin.buildModelFromUrdf(urdf)
+        data = model.createData()
+        pin.framesForwardKinematics(model, data, pin.neutral(model))
+        def pose(name):
+            fid = model.getFrameId(name)
+            if fid >= model.nframes:
+                raise ValueError(f"{urdf} has no frame {name}")
+            return data.oMf[fid].homogeneous.copy()
+        self.palm_in_wrist = {}
+        for side in ("left", "right"):
+            p = lambda link: pose(f"{side}_{link}")[:3, 3]
+            palm = palm_frame(p("hand_palm_link"), p("middle_proximal_link"), p("index_proximal_link"), p("pinky_proximal_link"))
+            self.palm_in_wrist[side] = np.linalg.inv(pose(f"{side}_wrist_roll_link")) @ palm
+        self.eye = (pose("head_yaw_link") @ np.append(np.asarray(camera_mount, dtype=float), 1.0))[:3]
+        self.shoulder = {side: pose(f"{side}_shoulder_pitch_link")[:3, 3] for side in ("left", "right")}
+        self.ik_origin = pose("waist_yaw_link")[:3, 3]
+        self.wrist_inertia = {}
+        for side in ("left", "right"):
+            jid = model.getJointId(f"{side}_wrist_roll_joint")
+            total = pin.Inertia.Zero()
+            for j in model.subtrees[jid]:
+                total += (data.oMi[jid].inverse() * data.oMi[j]).act(model.inertias[j])
+            self.wrist_inertia[side] = total
+        i = model.joints[model.getJointId("left_elbow_joint")].idx_q
+        def palm_distance(elbow):
+            q = pin.neutral(model)
+            q[i] = elbow
+            pin.framesForwardKinematics(model, data, q)
+            return float(np.linalg.norm((pose("left_wrist_roll_link") @ self.palm_in_wrist["left"])[:3, 3]
+                                        - pose("left_shoulder_pitch_link")[:3, 3]))
+        self.reach = 0.9 * max(palm_distance(e) for e in np.linspace(model.lowerPositionLimit[i], model.upperPositionLimit[i], 64))
+
+def pose_from_xyzw(pose):
+    x, y, z, qx, qy, qz, qw = [float(v) for v in pose]
+    T = np.eye(4)
+    T[:3, :3] = [[1 - 2 * (qy * qy + qz * qz), 2 * (qx * qy - qz * qw), 2 * (qx * qz + qy * qw)],
+                 [2 * (qx * qy + qz * qw), 1 - 2 * (qx * qx + qz * qz), 2 * (qy * qz - qx * qw)],
+                 [2 * (qx * qz - qy * qw), 2 * (qy * qz + qx * qw), 1 - 2 * (qx * qx + qy * qy)]]
+    T[:3, 3] = [x, y, z]
+    return T
+
+def rotation_log(R):
+    angle = np.arccos(np.clip((np.trace(R) - 1.0) / 2.0, -1.0, 1.0))
+    if angle < 1e-9:
+        return np.zeros(3)
+    v = np.array([R[2, 1] - R[1, 2], R[0, 2] - R[2, 0], R[1, 0] - R[0, 1]])
+    s = np.linalg.norm(v)
+    return v / s * angle if s > 1e-9 else np.zeros(3)
+
+def rotation_exp(w):
+    angle = np.linalg.norm(w)
+    if angle < 1e-12:
+        return np.eye(3)
+    k = w / angle
+    K = np.array([[0.0, -k[2], k[1]], [k[2], 0.0, -k[0]], [-k[1], k[0], 0.0]])
+    return np.eye(3) + np.sin(angle) * K + (1.0 - np.cos(angle)) * K @ K
+
+class OneEuroPose:
+    def __init__(self, min_cutoff=4.0, beta=40.0, beta_rot=4.0, d_cutoff=5.0):
+        self.min_cutoff, self.beta, self.beta_rot, self.d_cutoff = min_cutoff, beta, beta_rot, d_cutoff
+        self.reset()
+
+    def reset(self):
+        self.T, self.t, self.v, self.w = None, None, 0.0, 0.0
+
+    @staticmethod
+    def _alpha(cutoff, dt):
+        return 1.0 / (1.0 + 1.0 / (2.0 * np.pi * cutoff * dt))
+
+    def __call__(self, T, t):
+        if self.T is None:
+            self.T, self.t = T.copy(), t
+            return T.copy()
+        dt = max(t - self.t, 1e-3)
+        a_d = self._alpha(self.d_cutoff, dt)
+        step = T[:3, 3] - self.T[:3, 3]
+        self.v = a_d * np.linalg.norm(step) / dt + (1.0 - a_d) * self.v
+        turn = rotation_log(self.T[:3, :3].T @ T[:3, :3])
+        self.w = a_d * np.linalg.norm(turn) / dt + (1.0 - a_d) * self.w
+        out = np.eye(4)
+        out[:3, 3] = self.T[:3, 3] + self._alpha(self.min_cutoff + self.beta * self.v, dt) * step
+        out[:3, :3] = self.T[:3, :3] @ rotation_exp(self._alpha(self.min_cutoff + self.beta_rot * self.w, dt) * turn)
+        self.T, self.t = out, t
+        return out.copy()
+
+class OperatorPalm:
+    def __init__(self, tau=2.0):
+        self.tau, self.offset, self.t = tau, None, None
+
+    def __call__(self, points, wrist_pose, t):
+        built = operator_palm(points)
+        R_wrist = wrist_pose[:3, :3]
+        now = R_wrist.T @ built[:3, :3]
+        if self.offset is None:
+            self.offset = now
+        else:
+            a = 1.0 - np.exp(-min(max(t - self.t, 0.0), 0.5) / self.tau)
+            self.offset = self.offset @ rotation_exp(a * rotation_log(self.offset.T @ now))
+        self.t = t
+        out = built.copy()
+        out[:3, :3] = R_wrist @ self.offset
+        return out
+
+def panel_pose(center, eye):
+    n = np.asarray(eye, dtype=float) - center
+    n /= np.linalg.norm(n)
+    v = np.array([0.0, 0.0, 1.0]) - n[2] * n
+    v /= np.linalg.norm(v)
+    T = np.eye(4)
+    T[:3, :3] = np.column_stack([np.cross(v, n), v, n])
+    T[:3, 3] = center
+    return T
+
+class VRButtons:
+    SIZE = (0.12, 0.07)
+    ANCHORS = {"exit": (0.34, 0.66, 1.24), "reset": (0.34, 0.66, 1.115), "restart": (0.34, 0.66, 0.99),
+               "start": (0.34, 0.66, 0.865), "rec": (0.34, 0.66, 0.74)}
+    NEAR, FRONT, TOUCH, BEHIND, MARGIN, REARM = 0.20, 0.12, 0.012, 0.04, 0.015, 1.0
+    CONFIRMED, CONFIRM = ("reset", "exit"), 4.0
+
+    def __init__(self, names=None):
+        self.names = list(names or self.ANCHORS)
+        self.poses = {}
+        self.zone = {}
+        self.last_press = {}
+        self.armed = {}
+        self.hover, self.near = set(), False
+
+    def place(self, placement, eye_sim):
+        R = placement[:3, :3] / np.linalg.norm(placement[:3, 0])
+        T = np.eye(4)
+        T[:3, :3] = R
+        T[:3, 3] = (placement @ np.append(eye_sim, 1.0))[:3] - R @ eye_sim
+        for name in self.names:
+            self.poses[name] = T @ panel_pose(np.array(self.ANCHORS[name], dtype=float), eye_sim)
+
+    def confirm(self, now, name):
+        if now < self.armed.pop(name, -1.0):
+            return True
+        self.armed[name] = now + self.CONFIRM
+        return False
+
+    def step(self, now, fingertips):
+        pressed, self.hover, self.near = [], set(), False
+        for name, T in self.poses.items():
+            c, u, v, n = T[:3, 3], T[:3, 0], T[:3, 1], T[:3, 2]
+            for k, tip in enumerate(fingertips):
+                rel = tip - c
+                self.near |= np.linalg.norm(rel) < self.NEAR
+                inside = abs(rel @ u) <= self.SIZE[0] / 2 + self.MARGIN and abs(rel @ v) <= self.SIZE[1] / 2 + self.MARGIN
+                d = rel @ n
+                zone = "out" if not inside else "front" if self.TOUCH < d < self.FRONT else "touch" if -self.BEHIND <= d <= self.TOUCH else "out"
+                prev = self.zone.get((name, k), "out")
+                if zone != "out":
+                    self.hover.add(name)
+                if zone == "touch" and prev == "front" and now - self.last_press.get(name, -1e9) > self.REARM:
+                    self.last_press[name] = now
+                    pressed.append(name)
+                self.zone[(name, k)] = zone
+            for k in range(len(fingertips), 2):
+                self.zone[(name, k)] = "out"
+        return pressed
+
+    def panels(self, now, labels):
+        out = []
+        for name, T in self.poses.items():
+            text, colour, enabled = labels[name]
+            flash = now - self.last_press.get(name, -1e9) < 0.4
+            bg = np.array(colour, dtype=float)
+            if flash:
+                bg = 0.4 * bg + 0.6 * 255.0
+            elif name in self.hover and enabled:
+                bg = 0.7 * bg + 0.3 * 255.0
+            out.append({"key": f"ui-button-{name}", "size": list(self.SIZE), "matrix": T.flatten(order="F").tolist(),
+                        "bg": [int(c) for c in bg], "fg": [255, 255, 255] if enabled else [200, 200, 200],
+                        "border": [255, 255, 255] if name in self.hover else [20, 20, 20],
+                        "lines": [[text, 1.0]] if isinstance(text, str) else [list(l) for l in text]})
+        return out
+
