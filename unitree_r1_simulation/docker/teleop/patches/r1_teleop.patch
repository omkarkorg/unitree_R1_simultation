+def rot_y(a):
+    c, s = np.cos(a), np.sin(a)
+    return np.array([[c, 0.0, s], [0.0, 1.0, 0.0], [-s, 0.0, c]])
+
+def rot_z(a):
+    c, s = np.cos(a), np.sin(a)
+    return np.array([[c, -s, 0.0], [s, c, 0.0], [0.0, 0.0, 1.0]])
+
+def camera_rotation(head_q, mount_pitch):
+    sm, cm = np.sin(mount_pitch), np.cos(mount_pitch)
+    link_camera = np.array([[0.0, sm, -cm], [-1.0, 0.0, 0.0], [0.0, cm, sm]])
+    return rot_y(head_q[0]) @ rot_z(head_q[1]) @ link_camera
+
+def head_joints_for(gaze, mount_pitch):
+    g = gaze / np.linalg.norm(gaze)
+    sm, cm = np.sin(mount_pitch), np.cos(mount_pitch)
+    best, yaw0 = None, np.arcsin(np.clip(g[1] / cm, -1.0, 1.0))
+    for yaw in (yaw0, np.pi - yaw0):
+        pitch = np.arctan2(-sm, cm * np.cos(yaw)) - np.arctan2(g[2], g[0])
+        q = np.clip((np.array([pitch, yaw]) + np.pi) % (2.0 * np.pi) - np.pi, HEAD_LIMITS[:, 0], HEAD_LIMITS[:, 1])
+        alignment = -camera_rotation(q, mount_pitch)[:, 2] @ g
+        if best is None or alignment > best[0]:
+            best = (alignment, q)
+    return best[1]
