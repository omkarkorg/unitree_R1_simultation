+class TrackingGate:
+    def __init__(self, tvuer, hand_watch, settle=0.3, reach=1.0):
+        self.tvuer, self.hands, self.settle, self.reach = tvuer, hand_watch, settle, reach
+        self.ok_since, self.prev, self.prev_time = None, None, None
+
+    def in_vr(self, now):
+        return now - self.tvuer.xr_event_time < 0.5
+
+    def controllers_in_use(self, now):
+        return now - self.tvuer.controller_move_time < 0.5
+
+    def _glitch(self, now):
+        poses = (self.tvuer.left_arm_pose, self.tvuer.right_arm_pose)
+        if self.prev is not None and all(np.array_equal(a, b) for a, b in zip(poses, self.prev)):
+            return None
+        jump, dt = None, (now - self.prev_time) if self.prev is not None else None
+        if dt is not None and dt < 0.2:
+            for a, b in zip(poses, self.prev):
+                moved = np.linalg.norm(a[:3, 3] - b[:3, 3])
+                turned = np.arccos(np.clip((np.trace(a[:3, :3].T @ b[:3, :3]) - 1.0) / 2.0, -1.0, 1.0))
+                if moved > 0.05 + 3.0 * dt or turned > 0.3 + 25.0 * dt:
+                    jump = f"tracking jump ({moved * 100:.0f} cm, {np.degrees(turned):.0f} deg in {dt * 1000:.0f} ms)"
+        self.prev, self.prev_time = poses, now
+        return jump
+
+    def check(self, now):
+        tracked = self.hands.tracked(now)
+        glitch = self._glitch(now) if tracked else None
+        head = self.tvuer.head_pose[:3, 3]
+        far = tracked and any(np.linalg.norm(m[:3, 3] - head) > self.reach for m in (self.tvuer.left_arm_pose, self.tvuer.right_arm_pose))
+        reason = ("headset not in VR" if not self.in_vr(now) else
+                  ("controllers in use" if self.controllers_in_use(now) else "hands not tracked") if not tracked else
+                  glitch if glitch else
+                  "a hand is out of reach of the head" if far else None)
+        if reason is not None:
+            self.ok_since = None
+            return False, reason
+        if self.ok_since is None:
+            self.ok_since = now
+        return now - self.ok_since >= self.settle, "settling"
+
