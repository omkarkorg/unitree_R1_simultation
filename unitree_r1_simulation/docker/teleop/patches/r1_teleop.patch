+class OperatorFrame:
+    def __init__(self, tvuer):
+        self.tvuer, self.heading, self.version = tvuer, None, 0
+        self.last_head, self.last_vr = None, float("-inf")
+        self.eye_xr = None
+        self.history = []
+        self.world_scale, self.robot_eye_z = 1.0, None
+        self.scale = 1.0
+
+    def head(self):
+        raw = self.tvuer.head_pose
+        return T_ROBOT_OPENXR @ raw @ T_OPENXR_ROBOT if abs(np.linalg.det(raw[:3, :3])) > 0.5 else None
+
+    def update(self, now, in_vr):
+        head = self.head()
+        if not in_vr or head is None:
+            return
+        self.history = [h for h in self.history if h[0] > now - 1.0] + [(now, head[:3, 0].copy(), self.tvuer.head_pose[:3, 3].copy())]
+        reason = None
+        if self.heading is None:
+            reason = "headset in VR"
+        elif now - self.last_vr > 2.0:
+            reason = "headset back in VR"
+        elif self.last_head is not None:
+            turned = np.arccos(np.clip((np.trace(self.last_head[:3, :3].T @ head[:3, :3]) - 1.0) / 2.0, -1.0, 1.0))
+            if np.linalg.norm(head[:3, 3] - self.last_head[:3, 3]) > 0.3 or turned > 0.8:
+                reason = "view recentred"
+        if reason:
+            self.heading = get_Brobot_world_head_yaw_rot(head[:3, :3])
+            self.eye_xr = self.tvuer.head_pose[:3, 3].copy()
+            self.version += 1
+            logger_mp.info(f"🧭  {reason}: the robot's forward is now the direction you face")
+        self.last_head, self.last_vr = head, now
+
+    def calibrate(self, now, span=0.5):
+        recent = [h for h in self.history if h[0] > now - span]
+        if not recent:
+            return False
+        forward = np.mean([h[1] for h in recent], axis=0)
+        self.heading = get_Brobot_world_head_yaw_rot(np.column_stack([forward, np.zeros(3), np.zeros(3)]))
+        self.eye_xr = np.mean([h[2] for h in recent], axis=0)
+        self.version += 1
+        logger_mp.info("🧭  GO: the robot's eyes are now where yours are, its forward where you looked")
+        return True
+
+    def placement(self, eye_sim, robot_yaw=0.0):
+        s = self.world_scale
+        if s is None:
+            s = float(np.clip(self.eye_xr[1] / (self.robot_eye_z or eye_sim[2]), 1.0, MAX_WORLD_SCALE))
+        R = R_OPENXR_ROBOT @ self.heading @ rot_z(-robot_yaw)
+        T = np.eye(4)
+        T[:3, :3] = s * R
+        T[:3, 3] = self.eye_xr - s * R @ eye_sim
+        self.scale = s
+        return T
+
+    def gaze(self):
+        head = self.head()
+        return None if self.heading is None or head is None else self.heading.T @ head[:3, 0]
+
+    def wrists(self):
+        poses = []
+        for raw, to_arm in ((self.tvuer.left_arm_pose, T_TO_UNITREE_HUMANOID_LEFT_ARM),
+                            (self.tvuer.right_arm_pose, T_TO_UNITREE_HUMANOID_RIGHT_ARM)):
+            pose = T_ROBOT_OPENXR @ raw @ T_OPENXR_ROBOT @ to_arm
+            pose[:3, :3], pose[:3, 3] = self.heading.T @ pose[:3, :3], self.heading.T @ pose[:3, 3]
+            poses.append(pose)
+        return poses
+
+    def to_openxr(self, rotation_body):
+        return R_OPENXR_ROBOT @ self.heading @ rotation_body
