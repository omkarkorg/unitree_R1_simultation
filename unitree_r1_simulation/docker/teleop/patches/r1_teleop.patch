+        vx, vy = float(np.clip(v[0], *self.VX)), float(np.clip(v[1], *self.VY))
+        wz = float(np.clip(wz, -self.WZ, self.WZ))
+        if moving:
+            c, s = np.cos(self.yaw_target), np.sin(self.yaw_target)
+            def body(p):
+                d = p[:2] - self.anchor
+                return c * d[0] + s * d[1], -s * d[0] + c * d[1], p[2]
+            nf, _, nz = body(neck)
+            reach = [None if palm is None else body(palm[:3, 3]) for palm in (palms or ())]
+            cost = self.cost(self.grid[:, 0], self.grid[:, 1], (nf, nz), reach)
+            k = int(np.argmin(cost))
+            if cost[k] < self.cost(self.goal[0], self.goal[1], (nf, nz), reach) - self.HOLD_MARGIN / self.scale ** 2:
+                self.goal = self.grid[k].copy()
+            h_want, p_want = self.goal
+            if self.walking or self.turning:
+                h_want, p_want = self.H_NOM, 0.0
+            a = 1.0 if dt <= 0.0 else 1.0 - np.exp(-dt / self.SMOOTH)
+            self.h += a * (h_want - self.h)
+            self.p += a * (p_want - self.p)
+        if self.pose_mode:
+            d = np.array([self.anchor[0], self.anchor[1], self.yaw_target, self.h, self.p]) - self.pose
