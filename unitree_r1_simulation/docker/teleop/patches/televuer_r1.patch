+import json
+
+import cv2
+import numpy as np
+from vuer.schemas import AmbientLight, Box, Cylinder, DirectionalLight, Group, HemisphereLight, ImageBackground, TriMesh
+
+HIDDEN_LINKS = ("head_pitch_link", "head_yaw_link")
+PANEL_PX_PER_M = 1400
+
+
+def column_major(T):
+    return [round(float(v), 5) for v in np.asarray(T, dtype=float).flatten(order="F")]
+
+
+def pose_matrix(pose_xyzw):
+    x, y, z, qx, qy, qz, qw = [float(v) for v in pose_xyzw]
+    n = np.sqrt(qx * qx + qy * qy + qz * qz + qw * qw) or 1.0
+    qx, qy, qz, qw = qx / n, qy / n, qz / n, qw / n
+    T = np.eye(4)
+    T[:3, :3] = [[1 - 2 * (qy * qy + qz * qz), 2 * (qx * qy - qz * qw), 2 * (qx * qz + qy * qw)],
+                 [2 * (qx * qy + qz * qw), 1 - 2 * (qx * qx + qz * qz), 2 * (qy * qz - qx * qw)],
+                 [2 * (qx * qz - qy * qw), 2 * (qy * qz + qx * qw), 1 - 2 * (qx * qx + qy * qy)]]
+    T[:3, 3] = [x, y, z]
+    return T
+
+
+def hex_colour(rgb):
+    return "#" + "".join(f"{int(round(255 * min(max(float(c), 0.0), 1.0))):02x}" for c in rgb[:3])
+
+
+class LabScene:
+    def __init__(self, description, urdf, meshes):
+        import pinocchio as pin
+        self.pin = pin
+        self.desc = description
+        self.model = pin.buildModelFromUrdf(urdf)
+        self.data = self.model.createData()
+        self.q_index = []
+        for name in description["joint_names"]:
+            if not self.model.existJointName(name):
+                raise ValueError(f"lab view: joint {name} of the simulator is not in {urdf}")
+            self.q_index.append(self.model.joints[self.model.getJointId(name)].idx_q)
+        d = np.load(meshes)
+        self.items = [(m["link"], m["colour"], d[f"v{i}"], d[f"f{i}"]) for i, m in enumerate(json.loads(str(d["meta"])))
+                      if m["link"] not in HIDDEN_LINKS]
+        self.frames = {}
+        for link in sorted({it[0] for it in self.items}):
+            fid = self.model.getFrameId(link)
+            if fid >= self.model.nframes:
+                raise ValueError(f"lab view: link {link} of the meshes is not in {urdf}")
+            self.frames[link] = fid
+        self.root = pose_matrix(description["robot_root"])
+        self.objects = {o["name"]: o for o in description["objects"]}
+        self.sent = {}
+
+    def link_poses(self, q):
+        qq = self.pin.neutral(self.model)
+        qq[self.q_index] = np.asarray(q, dtype=float)
+        self.pin.framesForwardKinematics(self.model, self.data, qq)
+        return {link: self.root @ self.data.oMf[fid].homogeneous for link, fid in self.frames.items()}
+
+    def static_nodes(self, placement, state=None):
+        hidden = np.eye(4)
+        hidden[2, 3] = -10.0
+        poses = (state or {}).get("objects") or {}
+        if (state or {}).get("root") is not None:
+            self.root = pose_matrix(state["root"])
+        children = []
+        for b in self.desc["boxes"]:
+            room = b["name"].startswith(("room", "wall", "ceiling", "floor"))
+            children.append(Box(key=f"lab-{b['name']}", args=list(b["size"]), position=list(b["center"]),
+                                materialType="standard", material={"color": hex_colour(b["colour"]), "roughness": 0.9},
+                                castShadow=not room, receiveShadow=True))
+        for m in self.desc.get("meshes", []):
+            children.append(TriMesh(key=f"lab-{m['name']}", vertices=np.asarray(m["vertices"], dtype=np.float32),
+                                    faces=np.asarray(m["faces"], dtype=np.uint32), color=hex_colour(m["colour"]),
+                                    materialType="standard", castShadow=True, receiveShadow=True))
+        for name, o in self.objects.items():
+            if o["shape"] == "mesh":
+                shape = TriMesh(key=f"obj-{name}-shape", vertices=np.asarray(o["vertices"], dtype=np.float32),
+                                faces=np.asarray(o["faces"], dtype=np.uint32), color=hex_colour(o["colour"]),
+                                materialType="standard", castShadow=True, receiveShadow=True)
+            elif o["shape"] == "cylinder":
+                shape = Cylinder(key=f"obj-{name}-shape", args=[o["radius"], o["radius"], o["height"], 32],
+                                 rotation=[np.pi / 2, 0.0, 0.0], materialType="standard",
+                                 material={"color": hex_colour(o["colour"]), "roughness": 0.5}, castShadow=True, receiveShadow=True)
+            else:
+                shape = Box(key=f"obj-{name}-shape", args=list(o["size"]), materialType="standard",
+                            material={"color": hex_colour(o["colour"]), "roughness": 0.5}, castShadow=True, receiveShadow=True)
+            T = pose_matrix(poses[name]) if name in poses else hidden
+            self.sent[f"obj-{name}"] = T
+            children.append(Group(shape, key=f"obj-{name}", matrix=column_major(T)))
+        return Group(*children, key="lab", matrix=column_major(placement))
+
+    def robot_nodes(self, q, chunk=12):
+        poses = self.link_poses(q)
+        by_link = {}
+        for k, (link, colour, v, f) in enumerate(self.items):
+            by_link.setdefault(link, []).append(TriMesh(key=f"mesh-{k}", vertices=v, faces=f, color=hex_colour(colour),
+                                                        materialType="standard", castShadow=True, receiveShadow=True))
+        groups = [Group(*meshes, key=f"link-{link}", matrix=column_major(poses[link])) for link, meshes in by_link.items()]
+        for link in by_link:
+            self.sent[f"link-{link}"] = poses[link]
+        return [groups[i:i + chunk] for i in range(0, len(groups), chunk)]
+
+    def updates(self, state):
+        nodes = []
+        if state.get("root") is not None:
+            self.root = pose_matrix(state["root"])
+        if state.get("q") is not None and len(state["q"]) == len(self.q_index):
+            for link, T in self.link_poses(state["q"]).items():
+                key = f"link-{link}"
+                prev = self.sent.get(key)
+                if prev is None or np.abs(prev - T).max() > 2e-4:
+                    self.sent[key] = T
+                    nodes.append({"key": key, "matrix": column_major(T)})
+        for name, pose in (state.get("objects") or {}).items():
+            if name in self.objects:
+                key, T = f"obj-{name}", pose_matrix(pose)
+                prev = self.sent.get(key)
+                if prev is None or np.abs(prev - T).max() > 2e-4:
+                    self.sent[key] = T
+                    nodes.append({"key": key, "matrix": column_major(T)})
+        return nodes
+
+
+def lights():
+    return [
+        AmbientLight(key="lab-ambient", intensity=0.55),
+        HemisphereLight(key="lab-hemisphere", intensity=0.6, color="#ffffff", groundColor="#8a8a8a"),
+        DirectionalLight(key="lab-sun", intensity=1.4, position=[0.6, 3.0, 0.8], castShadow=True,
+                         **{"shadow-mapSize": [1024, 1024], "shadow-bias": -0.0005, "shadow-normalBias": 0.02,
+                            "shadow-camera-left": -1.6, "shadow-camera-right": 1.6, "shadow-camera-top": 1.6,
+                            "shadow-camera-bottom": -1.6, "shadow-camera-near": 0.5, "shadow-camera-far": 6.0}),
+    ]
+
+
+def panel_image(spec):
+    w, h = (max(8, int(round(s * PANEL_PX_PER_M))) for s in spec["size"])
+    img = np.zeros((h, w, 3), np.uint8)
+    img[:] = spec.get("bg", (30, 34, 40))
+    border = spec.get("border")
+    if border:
+        t = max(3, h // 18)
+        cv2.rectangle(img, (t // 2, t // 2), (w - 1 - t // 2, h - 1 - t // 2), tuple(int(c) for c in border), t)
+    lines = [(str(text), float(scale)) for text, scale in spec.get("lines", []) if str(text)]
+    if not lines:
+        return img
+    font, fg = cv2.FONT_HERSHEY_DUPLEX, tuple(int(c) for c in spec.get("fg", (255, 255, 255)))
+    total = sum(scale for _, scale in lines)
+    unit = 0.62 * h / (total + 0.35 * (len(lines) - 1))
+    sizes = []
+    for text, scale in lines:
+        fs = cv2.getFontScaleFromHeight(font, max(4, int(unit * scale)), 2)
+        thick = max(1, int(round(fs * 1.6)))
+        (tw, th), _ = cv2.getTextSize(text, font, fs, thick)
+        if tw > 0.92 * w:
+            fs *= 0.92 * w / tw
+            thick = max(1, int(round(fs * 1.6)))
+            (tw, th), _ = cv2.getTextSize(text, font, fs, thick)
+        sizes.append((text, fs, thick, tw, th))
+    block = sum(s[4] for s in sizes) + 0.35 * unit * (len(sizes) - 1)
+    y = (h - block) / 2.0
+    for text, fs, thick, tw, th in sizes:
+        y += th
+        cv2.putText(img, text, (int((w - tw) / 2), int(y)), font, fs, fg, thick, cv2.LINE_AA)
+        y += 0.35 * unit
+    return img
+
+
+def panel_node(spec):
+    img = panel_image(spec)
+    h, w = img.shape[:2]
+    return ImageBackground(img, key=spec["key"], fixed=True, matrix=list(spec["matrix"]), height=float(spec["size"][1]),
+                           aspect=w / h, format="png", interpolate=True, distanceToCamera=1.0)
